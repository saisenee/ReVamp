generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model Product {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  description String?
  price       Float
  currency    String?  @default("USD")
  shipping    Float?
  shippingType String? @default("domestic")
  images      String[]
  status      String?  @default("active")
  categories  String[]
  variations  Json?    // Store variation groups as JSON
  ownerId     String?  @db.ObjectId
  owner       User?    @relation(fields: [ownerId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model User {
  id       String    @id @default(auto()) @map("_id") @db.ObjectId
  sub      String    @unique
  email    String?
  name     String?
  picture  String?
  products Product[]
  orders   Order[]
}

model Business {
  id          String   @id @default("default") @map("_id")
  title       String   @default("My Business")
  description String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Order {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  orderNumber   String   @unique
  customerEmail String
  customerName  String?
  items         Json     // Array of {productId, title, quantity, price}
  total         Float
  status        String   @default("pending") // pending, processing, shipped, completed, cancelled
  shippingAddress Json?  // {street, city, province, postal, country}
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  // Link to user who placed order (optional)
  owner         User?    @relation(fields: [ownerId], references: [id])
  ownerId       String?  @db.ObjectId
}

model Collection {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  description String?
  order       Int       @default(0)
  productIds  String[]  @db.ObjectId
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}
